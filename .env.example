# Copy this to .env and fill in your values
# Register your app at: https://developers.eveonline.com/applications

EVE_CLIENT_ID=your_client_id_here
EVE_CLIENT_SECRET=your_client_secret_here
EVE_CALLBACK_URL=http://localhost:9555/auth/callback

# Generate a random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

DATABASE_URL=sqlite+aiosqlite:///./eve_industry.db
